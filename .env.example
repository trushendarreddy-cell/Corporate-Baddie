# Corporate-Baddie Environment Configuration Template
# Copy this file to .env and fill in only the providers you use.

API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATA_DIR=./server/data
VITE_API_URL=

LLM_PRIMARY=grok
LLM_TIMEOUT_MS=30000

XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=qwen/qwen3.8-27b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-5
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Optional Analytica-AI bridge.
# Set these only if you have the separate Analytica-AI project locally.
# Use paths appropriate to your own machine; do not commit them.
AGENT_PYTHON=
AGENT_HOME=
ANALYTICA_AI_HOME=
LLM_MODEL=
