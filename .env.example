# CorporateBaddie local configuration
# Copy this file to .env and add your own provider keys.
# Never commit .env or real API keys.

API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATA_DIR=./server/data
VITE_API_URL=

# LLM provider priority: grok, gemini, or zai
LLM_PRIMARY=grok
LLM_TIMEOUT_MS=30000

XAI_API_KEY=
XAI_MODEL=grok-4.6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ZAI_API_KEY=
ZAI_MODEL=glm-5
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
