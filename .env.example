# Corporate-Baddie Environment Configuration Template
# Copy this file to .env and supply your API keys

# Server & Network Configuration
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATA_DIR=./server/data
VITE_API_URL=

# LLM Orchestration & Fallback Engine
LLM_PRIMARY=grok
LLM_TIMEOUT_MS=30000

# xAI / Grok Provider Configuration
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=qwen/qwen3.8-27b

# Google Gemini Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Z.AI / GLM Provider Configuration
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-5
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
